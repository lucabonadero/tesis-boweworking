# --- Servidor ---
PORT=3001

# --- PostgreSQL (el proyecto usa el driver `pg`) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=boweworking

# --- JWT ---
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
# Opcional: duración del token (ej. 8h, 7d). Más largo = sesión más persistente sin volver a loguear.
JWT_EXPIRES_IN=8h

# --- CORS: URL exacta del front (incluye puerto) ---
FRONTEND_URL=http://localhost:5173
# Enlace en emails de recuperación de contraseña (mismo origen que el usuario abre en el navegador).
# PUBLIC_APP_URL es alias opcional si preferís separarlo de CORS.
#
# Límite extra: solicitudes de «olvidé contraseña» / validar token / restablecer (por IP).
# RATE_LIMIT_PASSWORD_FORGOT_MAX=8
# Producción: varios orígenes separados por coma (preview, app, etc.). Si no se define, se usa FRONTEND_URL.
# CORS_ORIGINS=https://app.tudominio.com,https://admin.tudominio.com
#
# Detrás de reverse proxy (nginx, Render, etc.), para rate limiting / IP correcta:
# TRUST_PROXY=1
#
# Límites por IP (express-rate-limit). Opcional; valores por defecto razonables en código.
# RATE_LIMIT_LOGIN_MAX=30
# RATE_LIMIT_REGISTRO_MAX=15
# RATE_LIMIT_GOOGLE_AUTH_MAX=40
# RATE_LIMIT_STAFF_REGISTRO_MAX=20
# RATE_LIMIT_MP_WEBHOOK_MAX=200

# --- Google Sign-In (ID token) ---
# Mismo valor que VITE_GOOGLE_CLIENT_ID en el frontend.
# Con este flujo NO hace falta Client Secret en el backend (solo verificación del JWT de Google).
GOOGLE_CLIENT_ID=289294103067-d99vv79q5fb1i1qcqvit3rpp97ih11kl.apps.googleusercontent.com

# --- Asistente IA ---
# Modo: openai (cloud, requiere créditos) | heuristic (gratis, sin API, reglas simples sobre tu DB)
ASISTENTE_IA_MODO=heuristic
#
# Cloud OpenAI (si ASISTENTE_IA_MODO=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
#
# API compatible OpenAI en local (gratis): instalá Ollama, ejecutá: ollama pull llama3.2
# Luego: ASISTENTE_IA_MODO=openai + OPENAI_BASE_URL=http://127.0.0.1:11434/v1 + OPENAI_MODEL=llama3.2
# (OPENAI_API_KEY puede quedar vacía en local; el backend usa un placeholder.)
OPENAI_BASE_URL=
#
# Zona horaria para ventana de fechas
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Correo (confirmación de reservas, nodemailer) ---
# Si falta alguno de estos tres, el backend omite el envío y solo registra un aviso en consola.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
# true solo si el puerto usa SSL directo (típico 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Opcional: remitente distinto al usuario (debe estar permitido por el proveedor)
# MAIL_FROM="Bo WeWorking <no-reply@tudominio.com>"
# MAIL_FROM_NAME=Bo WeWorking

# --- Mercado Pago ---
# Token de la aplicación (Checkout Pro / API de pagos)
MP_ACCESS_TOKEN=
# URL pública del backend (webhook de notificaciones). Ej: https://api.tudominio.com
BACKEND_URL=http://localhost:3001
# Secreto de firma del webhook (Tu integración > Webhooks en Mercado Pago). Obligatorio en producción.
MP_WEBHOOK_SECRET=
