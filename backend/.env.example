# Copiar a .env y completar. El .env real no se versiona.
# NUNCA commitear este archivo con valores reales.

PORT=3001

# --- Base de datos ---
# En produccion alcanza con DATABASE_URL (Render, Neon, Railway la proveen);
# si esta definida, las DB_* de abajo se ignoran y se activa TLS.
# DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=local

# --- Autenticacion ---
# Minimo 32 caracteres. Con NODE_ENV=production el server no arranca si es corto.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- CORS ---
# Origenes permitidos, separados por coma. En produccion, el dominio de Vercel.
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=https://tu-app.vercel.app,https://tu-app-preview.vercel.app

# --- URLs publicas ---
# Destino de los webhooks de Mercado Pago. En local, la URL de ngrok.
BACKEND_URL=http://localhost:3001

# --- Integraciones ---
MP_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
ASISTENTE_IA_MODO=heuristico

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true solo si el puerto usa SSL directo (tipico 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Produccion ---
# NODE_ENV=production
# Detras del proxy de Render: sin esto el rate limit ve una sola IP para todos.
# TRUST_PROXY=1
