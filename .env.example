# Copiar a .env y completar. El .env real no se versiona.

# URL del backend. En produccion, la URL publica de Render.
VITE_API_URL=http://localhost:3001

# Client ID de Google OAuth (tipo "Aplicacion web").
# Debe coincidir con GOOGLE_CLIENT_ID del backend.
VITE_GOOGLE_CLIENT_ID=

# Password del contenedor PostgreSQL de docker-compose.
# Debe coincidir con DB_PASSWORD de backend/.env.
POSTGRES_PASSWORD=admin
